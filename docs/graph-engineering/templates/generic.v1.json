{
  "format": "zcode-workflow",
  "version": 1,
  "name": "Sequential engineering",
  "description": "Analyze an explicit request, implement it, execute operator-selected Build/Test recipes, review current evidence and require final human approval.",
  "graph": {
    "version": 5,
    "revision": 0,
    "name": "Sequential engineering",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "position": {
          "x": 40,
          "y": 100
        },
        "request": ""
      },
      {
        "id": "analyze",
        "type": "task",
        "name": "Analyze",
        "position": {
          "x": 300,
          "y": 100
        },
        "instructions": "Workflow task: analyze.\nAnalyze the explicit request and selected project. Read relevant native project instructions and selected source references. Identify affected behavior, unknowns and acceptance criteria. Link each rule to a source reference or label it a question. Do not edit or execute commands.\nrequest:\n{{inputs.request}}",
        "instructionMode": "bound",
        "inputs": [
          {
            "alias": "request",
            "source": {
              "kind": "start"
            }
          }
        ],
        "configuration": {
          "kind": "inherit"
        }
      },
      {
        "id": "implement",
        "type": "task",
        "name": "Implement",
        "position": {
          "x": 560,
          "y": 100
        },
        "instructions": "Workflow task: implement.\nImplement only the approved request using the explicit Analyze handoff and normal native project tools. Preserve unrelated work and test authority. Do not invent missing rules or tooling; ask when blocked. Configured Build/Test nodes execute the verification recipes afterward.\nrequest:\n{{inputs.request}}\n\nanalyze:\n{{inputs.analyze}}",
        "instructionMode": "bound",
        "inputs": [
          {
            "alias": "request",
            "source": {
              "kind": "start"
            }
          },
          {
            "alias": "analyze",
            "source": {
              "kind": "node",
              "nodeId": "analyze"
            }
          }
        ],
        "configuration": {
          "kind": "inherit"
        }
      },
      {
        "id": "build",
        "type": "tool",
        "name": "Build",
        "position": {
          "x": 820,
          "y": 100
        },
        "recipeId": "build"
      },
      {
        "id": "test",
        "type": "tool",
        "name": "Test configured criteria",
        "position": {
          "x": 1080,
          "y": 100
        },
        "recipeId": "test"
      },
      {
        "id": "reviewer",
        "type": "task",
        "name": "Review current verification",
        "position": {
          "x": 1340,
          "y": 100
        },
        "instructions": "Workflow task: reviewer.\nReview the explicit request against the current Test verification supplied as evidence. Decide whether the verified machine result satisfies the request's stated acceptance criteria. Return exactly one JSON object with outcome pass, needs_changes or needs_human; findings as {code,message} records; and evidenceReferences containing only the permitted evidence artifact IDs supplied below. A failed Test can never be pass. A passing Test is evidence of the machine check, not a guarantee that the requested change is correct; return needs_changes only for a concrete issue grounded in the supplied request and verification evidence, otherwise pass. Do not invent acceptance criteria the request did not state; in particular, do not require Git-tracked or committed source unless an explicit supplied criterion says so. Unsupported uncertainty must be needs_human, not an invented blocking rule. Do not edit files or run commands; the verification artifact already contains the machine result.\nrequest:\n{{inputs.request}}\n\nverification:\n{{inputs.verification}}",
        "instructionMode": "bound",
        "inputs": [
          {
            "alias": "request",
            "source": {
              "kind": "start"
            }
          },
          {
            "alias": "verification",
            "source": {
              "kind": "artifact",
              "nodeId": "test",
              "selector": "verification"
            }
          }
        ],
        "configuration": {
          "kind": "inherit"
        },
        "output": {
          "kind": "json",
          "schema": {
            "type": "object",
            "required": [
              "outcome",
              "findings",
              "evidenceReferences"
            ],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "needs_changes",
                  "needs_human"
                ]
              },
              "findings": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                }
              },
              "evidenceReferences": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      },
      {
        "id": "final-gate",
        "type": "approval",
        "name": "Final human review",
        "position": {
          "x": 40,
          "y": 320
        },
        "reviewInstructions": "Review this exact source-linked evidence, diff and unresolved questions. Approve only the selected scope. This does not authorize publication or answer native permissions.",
        "evidence": [
          {
            "alias": "evidence",
            "source": {
              "kind": "artifact",
              "nodeId": "test",
              "selector": "test"
            }
          },
          {
            "alias": "review",
            "source": {
              "kind": "artifact",
              "nodeId": "reviewer",
              "selector": "structured"
            }
          },
          {
            "alias": "source",
            "source": {
              "kind": "source"
            }
          }
        ],
        "commentPolicy": "required"
      },
      {
        "id": "end",
        "type": "end",
        "position": {
          "x": 300,
          "y": 320
        },
        "outputNodeId": "test"
      }
    ],
    "edges": [
      {
        "source": "start",
        "target": "analyze"
      },
      {
        "source": "analyze",
        "target": "implement"
      },
      {
        "source": "implement",
        "target": "build"
      },
      {
        "source": "build",
        "target": "test"
      },
      {
        "source": "test",
        "target": "reviewer"
      },
      {
        "source": "reviewer",
        "target": "final-gate"
      },
      {
        "source": "final-gate",
        "target": "end"
      }
    ],
    "routing": {
      "finalGateId": "final-gate",
      "limits": {
        "maxNodeAdmissions": 24,
        "deadlineMs": 1800000
      }
    }
  },
  "parameters": [
    {
      "id": "request",
      "label": "Explicit run request",
      "type": "string",
      "required": true
    }
  ],
  "references": [
    {
      "id": "instructions",
      "label": "Additional project instructions",
      "kind": "instruction",
      "required": false,
      "nodeIds": [
        "analyze",
        "implement"
      ]
    },
    {
      "id": "skill",
      "label": "Existing native skill",
      "kind": "skill",
      "required": false,
      "nodeIds": [
        "implement"
      ]
    }
  ],
  "optionalNodes": []
}
